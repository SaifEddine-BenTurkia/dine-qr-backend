generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  fullName         String
  phone            String?
  phoneCountryCode String?
  // ISO 3166-1 alpha-2, drives the billing currency.
  country          String    @default("TN")
  address          String?
  taxId            String?
  emailVerifiedAt  DateTime?
  // Bumped on password reset so tokens issued before it stop working.
  tokenVersion     Int       @default(0)
  // Admin second factor (authenticator app). Secret sealed with a key derived
  // from JWT_SECRET; lastTotpStep stops a code from being used twice.
  totpSecret       String?
  totpEnabledAt    DateTime?
  lastTotpStep     Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  restaurant      Restaurant?
  subscription    Subscription?
  tokens          UserToken[]
  paymentRequests PaymentRequest[]
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// Single-use tokens sent by email. Only the SHA-256 hash is stored, so a
// database leak does not hand out working links.
model UserToken {
  id        String        @id @default(uuid())
  userId    String
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Restaurant {
  id             String   @id @default(uuid())
  userId         String   @unique
  name           String
  slug           String   @unique
  description    String?
  logoUrl        String?
  primaryColor   String?
  // Visual style of the public menu; see MENU_TEMPLATES in restaurant.dto.ts.
  template       String   @default("classic")
  // Guest WiFi, shown by the WiFi button on the guest menu (P1-05).
  wifiSsid       String?
  wifiPassword   String?
  // Google review link: https://search.google.com/local/writereview?placeid=<id> (P1-08).
  googlePlaceId  String?
  // Menu languages (P1-03): the default first; French is always available.
  defaultLocale  String   @default("fr")
  enabledLocales String[] @default(["fr"])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories      Category[]
  scans           Scan[]
  feedback        Feedback[]
  tables          DiningTable[]
  serviceRequests ServiceRequest[]
  events          Event[]
}

// A physical table with its own QR code (P1-01). The token is random and
// rotatable, never sequential: https://<menu>/m/<slug>?t=<token>.
model DiningTable {
  id           String   @id @default(uuid())
  restaurantId String
  label        String
  zone         String?
  token        String   @unique
  position     Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]

  @@unique([restaurantId, label])
  @@index([restaurantId, position])
}

enum ServiceRequestType {
  WAITER
  BILL_CASH
  BILL_CARD
}

enum ServiceRequestStatus {
  OPEN
  ACKNOWLEDGED
  DONE
  CANCELLED
}

// "Appeler le serveur" and "L'addition" from the guest menu (P1-05, P1-06).
model ServiceRequest {
  id             String               @id @default(uuid())
  restaurantId   String
  tableId        String
  sessionId      String
  type           ServiceRequestType
  status         ServiceRequestStatus @default(OPEN)
  createdAt      DateTime             @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      DiningTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status, createdAt])
  @@index([tableId, type, createdAt])
}

// Append-only guest and staff actions (P0-06), the source of every dashboard
// number. No personal data: sessions are random IDs made by the browser.
model Event {
  id           String   @id @default(uuid())
  restaurantId String
  type         String
  tableId      String?
  sessionId    String?
  itemId       String?
  props        Json?
  occurredAt   DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, type, occurredAt])
  @@index([restaurantId, occurredAt])
}

model Category {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  // Translations keyed by locale, e.g. {"en": "Starters", "ar": "مقبلات"} (P1-03).
  nameI18n     Json?
  // Locales whose translation came from AI and is not yet checked by the owner.
  aiLocales    String[] @default([])
  position     Int
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes     Dish[]

  @@index([restaurantId, position])
}

model Dish {
  id              String    @id @default(uuid())
  categoryId      String
  name            String
  description     String?
  // Integer millimes (1 DT = 1000), never floats (P0-04).
  priceMillimes   Int
  imageUrl        String?
  position        Int
  available       Boolean   @default(true)
  // Sold out (P1-04): shown greyed "Épuisé"; soldOutUntil resets it (05:00 Tunis).
  soldOut         Boolean   @default(false)
  soldOutUntil    DateTime?
  nameI18n        Json?
  descriptionI18n Json?
  // Locales whose translation came from AI and is not yet checked by the owner.
  aiLocales       String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, position])
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

// One per user. Payments are collected in cash for now: an admin confirms a
// PaymentRequest and that extends currentPeriodEnd.
model Subscription {
  id               String             @id @default(uuid())
  userId           String             @unique
  status           SubscriptionStatus
  currency         String             @default("TND")
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PaymentContactMethod {
  WHATSAPP
  EMAIL
  PHONE
}

enum PaymentRequestStatus {
  PENDING
  PAID
  REJECTED
  CANCELED
}

// The manual payment queue: an owner asks to pay, an admin collects the cash
// and marks it paid.
model PaymentRequest {
  id             String               @id @default(uuid())
  // Short code the owner quotes on WhatsApp or by phone, e.g. TQ-7F3K2A.
  reference      String               @unique
  userId         String
  months         Int
  // Integer millimes (P0-04).
  amountMillimes Int
  currency       String               @default("TND")
  contactMethod  PaymentContactMethod
  note           String?
  status         PaymentRequestStatus @default(PENDING)
  amountReceivedMillimes Int?
  adminNote      String?
  handledBy      String?
  handledAt      DateTime?
  // Paid period this request granted, kept for the audit trail.
  periodStart    DateTime?
  periodEnd      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Scan {
  id           String   @id @default(uuid())
  restaurantId String
  // Salted hash of the visitor address, used only to de-duplicate scans.
  visitorHash  String
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@index([restaurantId, visitorHash, createdAt])
}

model Feedback {
  id             String   @id @default(uuid())
  restaurantId   String
  rating         Int
  comment        String?
  // P1-08: tags (service, plats, attente, prix, proprete, ambiance), table,
  // and contact details only with explicit consent.
  tags           String[] @default([])
  tableLabel     String?
  contactConsent Boolean  @default(false)
  contact        String?
  createdAt      DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
}
