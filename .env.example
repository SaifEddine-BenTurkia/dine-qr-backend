# Local development. `npm run env:init` creates .env.sandbox (loaded first,
# preferred over .env) with generated secrets; paste sandbox or capped keys
# there. Never run development with live keys. Production values live on the
# VPS only. `npm run env:check` validates without printing values.

# development | prelaunch | production (PLAN section 20). Unset on a
# production build means prelaunch: sandbox rules and the outbound allowlist.
APP_ENV=development
# Before launch, email and WhatsApp only reach these addresses and phones
# (comma-separated). Empty: the ADMIN_EMAILS accounts only.
SANDBOX_ALLOWED_RECIPIENTS=
NODE_ENV=development
PORT=3001

# `docker compose up -d` starts this database (see compose.yml).
DATABASE_URL=postgresql://tableqr:tableqr@localhost:5434/tableqr

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
SCAN_HASH_SALT=change-me-too-another-long-random-string

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Optional locally: without a key, email links are printed to the console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=TableQR <onboarding@resend.dev>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tableqr-dev
CLOUDINARY_LIBRARY_FOLDER=tableqr-library

# Cash payments: admins confirm requests in the dashboard (/admin/payments).
# Comma-separated; these accounts get the admin page and the request emails.
ADMIN_EMAILS=
# Shown to owners as ways to reach you about a payment (any can be empty).
# WhatsApp in international format without "+", e.g. 21620123456.
PAYMENT_WHATSAPP=
PAYMENT_CONTACT_EMAIL=
PAYMENT_PHONE=

TRIAL_DAYS=30
# Monthly prices of the three plans (Standard, Premium, Business); a year costs 10 months.
PRICE_TND=49
PRICE_PREMIUM_TND=99
PRICE_BUSINESS_TND=179
# Durations on sale, with the Standard prices: "months:price" pairs.
PAYMENT_PLANS=1:49,12:490

# Keys: comma-separated, requests rotate through them.
# Models: comma-separated, tried in order. Free models are often saturated, so
# end with a cheap paid one (Mistral Small: ~$0.0001 per import; needs credit).
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free,mistralai/mistral-small-3.2-24b-instruct
