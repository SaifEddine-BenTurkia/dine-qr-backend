# Local development. Copy to .env and adjust.
# Production values are generated on the VPS by deployment/bootstrap-env.sh.
NODE_ENV=development
PORT=3001

# `docker compose up -d` starts this database (see compose.yml).
DATABASE_URL=postgresql://tableqr:tableqr@localhost:5433/tableqr

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
SCAN_HASH_SALT=change-me-too-another-long-random-string

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Optional locally: without a key, email links are printed to the console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=TableQR <onboarding@resend.dev>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tableqr-dev
CLOUDINARY_LIBRARY_FOLDER=tableqr-library

# sandbox | production
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=

TRIAL_DAYS=30
PRICE_TND=35
PRICE_EUR=12
PRICE_USD=12

# Comma-separated; requests rotate through them.
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
